{
  "name": "four-wins",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /four-wins/ && node scripts/copy-test-reports.mjs",
    "watch": "ng build --watch --configuration development",
    "unit": "vitest run --reporter=html --outputFile=test-report/unit/index.html --reporter=default",
    "e2e": "playwright test",
    "check": "pnpm unit && pnpm e2e"
  },
  "private": true,
  "packageManager": "pnpm@10.1.0",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngrx/signals": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/ui": "^4.1.12",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.0"
  }
}