{
  "name": "four-wins",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /four-wins/",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-strip-types --import ./test/register.mjs --test --experimental-test-coverage --test-coverage-include='src/app/**/*.ts' test/game-logic.test.ts test/reader.test.ts test/metrics.test.ts",
    "test:e2e": "playwright test",
    "metrics": "node scripts/metrics.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "pnpm metrics && pnpm build && pnpm check:docs"
  },
  "private": true,
  "packageManager": "pnpm@10.1.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngrx/signals": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "istanbul-lib-coverage": "^3.2.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "v8-to-istanbul": "^9.3.0"
  }
}
